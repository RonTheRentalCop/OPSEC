#!/usr/bin/env bash

set -euo pipefail

VERSION="0.1.0 (early development)"

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *)  self="$(dirname "$self")/$target" ;;
  esac
done
ROOT_DIR="$(cd "$(dirname "$self")/.." && pwd)"
TIERS_DIR="$ROOT_DIR/tiers"

show_help() {
  cat <<'EOF'
opsec - tiered privacy and security setup

Tier 0 is the most locked down. Tier 4 is the everyday starting point.

Usage:
  opsec tiers      Explain the five tiers and who each one is for
  opsec tier <n>   Show everything in one tier, from 0 to 4
  opsec up         Pick a tier, review the changes, confirm, then apply
  opsec up <n>     Same, for tier n (add --dry-run to only see the plan)
  opsec status     Check which protections are on (add --online to test the VPN)
  opsec down       Undo the settings files OPSEC wrote
  opsec vm         Build, start or delete the sealed Tor-only virtual machine
  opsec version    Show the version
  opsec help       Show this message

Only 'opsec up', 'opsec down' and 'opsec vm' change your computer, and
each one asks first. OPSEC keeps no log of what you run.
EOF
}

show_tiers() {
  cat <<'EOF'
Tier 0  Lockdown    For people at serious risk. Separates everything you do
                    and leaves nothing behind.
Tier 1  Anonymous   A sealed virtual machine where everything goes through
                    Tor. Hides who you are from websites and your network.
Tier 2  Hardened    Makes the computer much harder to break into, even if you
                    open a bad file or plug in a bad USB stick.
Tier 3  Private     Stops your internet provider, public Wi-Fi and advertisers
                    from watching what you do. Protects a lost or stolen laptop.
Tier 4  Hygiene     Everyone. Blocks ads, trackers, scams and common malware.

Tier 0 is the strongest. Each tier includes the higher-numbered ones.
The closer to Tier 0, the slower and less convenient things get.
Most people only need Tier 4 or Tier 3.

Run 'opsec tier <n>' to see everything in one tier.
EOF
}

show_tier() {
  case "${1:-}" in
    0|1|2|3|4) ;;
    *)
      echo "Pick a tier from 0 to 4, for example: opsec tier 4" >&2
      exit 1
      ;;
  esac
  local file
  file="$(ls "$TIERS_DIR"/tier"$1"-*.md 2>/dev/null | head -n 1)"
  if [ -z "$file" ]; then
    echo "Could not find the description for tier $1 in $TIERS_DIR" >&2
    exit 1
  fi
  cat "$file"
}

case "${1:-help}" in
  help|-h|--help)       show_help ;;
  version|-v|--version) echo "opsec $VERSION" ;;
  tiers)                show_tiers ;;
  tier)                 show_tier "${2:-}" ;;
  up)
    shift
    . "$ROOT_DIR/lib/engine.sh"
    opsec_up "$@"
    ;;
  vm)
    shift
    . "$ROOT_DIR/lib/engine.sh"
    . "$ROOT_DIR/lib/vm.sh"
    opsec_vm "$@"
    ;;
  status)
    shift
    . "$ROOT_DIR/lib/engine.sh"
    . "$ROOT_DIR/lib/status.sh"
    opsec_status "$@"
    ;;
  down)
    shift
    . "$ROOT_DIR/lib/engine.sh"
    . "$ROOT_DIR/lib/down.sh"
    opsec_down "$@"
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Run 'opsec help' to see what is available." >&2
    exit 1
    ;;
esac
